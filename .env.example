# HarithKavish Account — environment template.
# Copy to .env.local for development. Never commit real values; .env* is gitignored
# except this file.
#
# All tooling (the app, drizzle-kit, migrations and the verification scripts)
# loads env files through Next.js's own loader, so they always agree on which
# file wins. Run `npm run env:check` to see what resolved and where it points.
#
# DATABASE_URL and DATABASE_URL_UNPOOLED MUST address the same database — one
# pooled, one direct. Startup refuses to continue if they disagree.

# Public origin the app is served from.
NEXT_PUBLIC_SITE_URL=https://account.harithkavish.com

# --------------------------------------------------------------------------
# Database — Neon (PostgreSQL). Both are shown on the Neon dashboard.
# --------------------------------------------------------------------------

# Pooled connection, used by the running app. Ends with "-pooler" in the host.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection, used by migrations and verification. PgBouncer cannot run
# the session-level statements that DDL needs, so this must NOT be the pooled
# URL — but it must point at the SAME database. Required; there is no fallback.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------------------------
# Rate limiting — Upstash Redis.
# Account creation fails closed if these are absent, so they are required.
# --------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------------------------------
# Not used yet. The Authentication Platform (auth.harithkavish.com) is a
# separate service; its service-to-service contract with this platform has not
# been defined, so nothing here reads these.
# --------------------------------------------------------------------------

# AUTH_PLATFORM_URL=https://auth.harithkavish.com

# Google as an upstream identity provider (contract §7.6).
# The secret is used only in a server-to-server token exchange and must never
# reach a browser. No Google token is stored anywhere (V26).
#
# Authorized JavaScript origin:  https://account.harithkavish.com
# Authorized redirect URI:       https://account.harithkavish.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
