# HarithKavish Account — environment template.
# Copy to .env.local for development. Never commit real values; .env* is gitignored.

# Public origin the app is served from. Used for absolute URLs and, from Phase 4,
# as the WebAuthn relying party origin.
NEXT_PUBLIC_SITE_URL=https://account.harithkavish.com

# ---------------------------------------------------------------------------
# Phase 2+ — not read by any code yet. Listed so deployment can be prepared.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/harithkavish_account

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
# SESSION_SECRET=

# WebAuthn relying party settings (Phase 4).
# WEBAUTHN_RP_ID=account.harithkavish.com
# WEBAUTHN_RP_NAME=HarithKavish Account
